<div>
    @(Html.Kendo().Grid<Meo.Web.ViewModels.ProductSettlementReport>()
        .Name("GridProductSettlement")
        .HtmlAttributes(new { style = "width:100%" })
        .Columns(columns =>
        {
            columns.Bound(c => c.PaymentDate).Title("Date").ClientTemplate("#= kendo.toString(kendo.parseDate(PaymentDate), 'dd/MM/yyyy') #").Width(120);
            columns.Bound(c => c.SalesId).Title("Invoice No").Width(130);
            columns.Bound(c => c.CustomerName).Title("Customer");
            columns.Bound(c => c.ProductName).Title("Product");
            columns.Bound(c => c.Quantity).Title("Qty").Width(70);
            columns.Bound(c => c.UnitPrice).Title("Unit Price").Width(110);
            columns.Bound(c => c.LineDiscAmt).Title("Discount").Width(110);
            columns.Bound(c => c.LineTotal).Title("Total").Width(110);
        })
        .ToolBar(t => t.Custom().Name("exportAll").Text("Export to Excel").HtmlAttributes(new { onclick = "exportCombinedReport(); return false;", style = "float: right" }))
        .Sortable()
        .Filterable()
        .Pageable(pageable => pageable
            .Refresh(true).Messages(m => m.Refresh(string.Empty)))
        .DataSource(source => source
            .Ajax()
            .PageSize(50)
            .Events(events => events.Error("error_handler"))
            .Sort(sort => sort.Add("PaymentDate").Descending())
            .Read(read => read.Action("GetProductSettlementData", "Report", new { startDate = ViewBag.StartDate, endDate = ViewBag.EndDate }))
        )
        .NoRecords("No Records Found")
    )
</div>

<script>
    function exportCombinedReport() {
        var startDate = '@ViewBag.StartDate';
        var endDate = '@ViewBag.EndDate';

        $.when(
            $.ajax({ url: '@Url.Content("~/Setting/GetAllProductBalances")', type: 'GET' }),
            $.ajax({ url: '@Url.Content("~/Stock/GetReceivedByDateRange")', type: 'GET', data: { startDate: startDate, endDate: endDate } }),
            $.ajax({ url: '@Url.Content("~/Report/GetProductSettlementRaw")', type: 'GET', data: { startDate: startDate, endDate: endDate } })
        ).done(function (balanceResp, receiveResp, settlementResp) {
            var balances = balanceResp[0];
            var received = receiveResp[0];
            var settlements = settlementResp[0];

            function headerRow(titles) {
                return { cells: titles.map(function (t) { return { value: t, bold: true }; }) };
            }

            var balanceSheet = {
                columns: [{ width: 120 }, { width: 220 }, { width: 100 }],
                title: "Balance",
                rows: [headerRow(["Product Code", "Product Name", "Current Balance"])]
                    .concat(balances.map(function (r) {
                        return { cells: [{ value: r.ProductCode }, { value: r.ProductName }, { value: r.Balance }] };
                    }))
            };

            var receiveSheet = {
                columns: [{ width: 100 }, { width: 110 }, { width: 120 }, { width: 220 }, { width: 100 }],
                title: "Receive",
                rows: [headerRow(["Date", "PO No", "Product Code", "Product Name", "Qty Received"])]
                    .concat(received.map(function (r) {
                        return {
                            cells: [
                                { value: r.PODate ? kendo.toString(kendo.parseDate(r.PODate), 'dd/MM/yyyy') : '' },
                                { value: r.PONo },
                                { value: r.ProductCode },
                                { value: r.ProductName },
                                { value: r.Qty },
                            ]
                        };
                    }))
            };

            var settlementSheet = {
                columns: [{ width: 100 }, { width: 110 }, { width: 160 }, { width: 220 }, { width: 70 }, { width: 100 }, { width: 100 }, { width: 100 }],
                title: "Settlement",
                rows: [headerRow(["Date", "Invoice No", "Customer", "Product", "Qty", "Unit Price", "Discount", "Total"])]
                    .concat(settlements.map(function (r) {
                        return {
                            cells: [
                                { value: r.PaymentDate ? kendo.toString(kendo.parseDate(r.PaymentDate), 'dd/MM/yyyy') : '' },
                                { value: r.SalesId },
                                { value: r.CustomerName },
                                { value: r.ProductName },
                                { value: r.Quantity },
                                { value: r.UnitPrice },
                                { value: r.LineDiscAmt },
                                { value: r.LineTotal },
                            ]
                        };
                    }))
            };

            var workbook = new kendo.ooxml.Workbook({
                sheets: [balanceSheet, receiveSheet, settlementSheet]
            });

            kendo.saveAs({
                dataURI: workbook.toDataURL(),
                fileName: "ProductReport.xlsx"
            });
        }).fail(function () {
            alert("Failed to export report. Please try again.");
        });
    }
</script>
