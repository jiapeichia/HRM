@model Meo.Web.ViewModels.PaymentViewModels

@{
    ViewBag.Title = "Payment";
    var paymentType = ViewBag.PaymentType;
}

<head>
    @Styles.Render("~/Content/css")
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f4f8;
            display: flex;
            justify-content: center;
            align-items: stretch;
            padding: 8px;
        }

        .payment-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
            width: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .payment-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3d5a80 100%);
            color: #fff;
            padding: 8px 20px;
            text-align: center;
            flex-shrink: 0;
        }

        .payment-header h2 {
            font-size: 1.6rem;
            font-weight: 700;
            display: inline;
            letter-spacing: 0.3px;
        }

        .payment-header .invoice-id {
            font-size: 1.25rem;
            opacity: 0.85;
            display: inline;
            margin-left: 8px;
            letter-spacing: 0.5px;
        }

        .payment-body {
            padding: 10px 20px 6px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .section-divider {
            border: none;
            border-top: 1px solid #e8ecf0;
            margin: 7px 0;
            flex-shrink: 0;
        }

        .field-row {
            display: flex;
            align-items: center;
            margin-bottom: 7px;
            flex-shrink: 0;
        }

        .field-row label {
            width: 170px;
            min-width: 170px;
            font-weight: 600;
            font-size: 1.38rem;
            color: #3d5a80;
        }

        .field-row .field-value {
            flex: 1;
            font-size: 1.38rem;
            color: #222;
            font-weight: 500;
        }

        .field-row input[type="text"],
        .field-row input[type="number"],
        .field-row select {
            flex: 1;
            padding: 6px 10px;
            border: 1px solid #d0d7de;
            border-radius: 6px;
            font-size: 1.38rem;
            color: #222;
            background: #fafbfc;
            transition: border-color 0.2s;
            width: 100%;
        }

        .field-row input:focus,
        .field-row select:focus {
            outline: none;
            border-color: #3d5a80;
            background: #fff;
        }

        .field-row input:disabled {
            background: #f0f4f8;
            color: #555;
            cursor: not-allowed;
        }

        .total-section {
            background: #f7f9fc;
            border-radius: 8px;
            padding: 8px 14px;
            margin: 2px 0 6px;
            flex-shrink: 0;
        }

        .total-section .field-row { margin-bottom: 6px; }
        .total-section .field-row:last-child { margin-bottom: 0; }

        .total-section .field-row label,
        .total-section .field-row input { font-size: 1.38rem; }

        .highlight-row label {
            font-weight: 700;
            color: #2c3e50;
            font-size: 1.38rem;
        }

        .highlight-row input {
            font-weight: 700;
            color: #2c3e50;
            font-size: 1.38rem;
            border-color: #3d5a80;
            background: #fff;
        }

        .min-pay-note {
            font-size: 0.9rem;
            color: #e74c3c;
            margin-top: 3px;
            flex: 1;
            margin-left: 170px;
        }

        .payment-footer {
            display: flex;
            gap: 10px;
            padding: 8px 20px 10px;
            flex-shrink: 0;
        }

        .btn-confirm {
            flex: 1;
            padding: 10px;
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            color: #fff;
            border: none;
            border-radius: 7px;
            font-size: 1.32rem;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn-confirm:hover { opacity: 0.88; }

        .btn-cancel {
            flex: 1;
            padding: 10px;
            background: #ecf0f1;
            color: #555;
            border: none;
            border-radius: 7px;
            font-size: 1.32rem;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-cancel:hover { background: #dde1e4; }
    </style>
    <script>
        function calculateBalance() {
            var total = parseFloat(document.getElementById("TotalAmt").value) || 0;
            var discount = parseFloat(document.getElementById("DiscAmt").value) || 0;
            var paid = parseFloat(document.getElementById("PaidAmt").value) || 0;
            var balance = total - discount - paid;
            document.getElementById("BalAmt").value = balance.toFixed(2);
        }

        window.onload = function () {
            var paidAmtField = document.getElementById('PaidAmt');
            paidAmtField.focus();
            paidAmtField.select();
        };

        $(document).ready(function () {
            $("#updatePayment").on("click", function () {
                var totalAmt = $("#TotalAmt").val();
                var paymethod = $("#PaymentMethod").val();

                if (totalAmt === "0" || totalAmt === "") {
                    return alert("Nothing to process to payment.");
                }
                if (paymethod === "") {
                    return alert("Payment method is required.");
                }

                var paytype = $("#PaymentMethod").val();
                var ttlamt = parseFloat($("#TotalAmt").val()) || 0;
                var payamt = parseFloat($("#PaidAmt").val()) || 0;
                var discamt = parseFloat($("#DiscAmt").val()) || 0;
                var balamt = payamt - (ttlamt - discamt);

                $.ajax({
                    url: '@Url.Action("Update_Payment", "Sales")',
                    type: "POST",
                    data: {
                        CusId: @Model.CusId,
                        SalesId: "@Model.SalesId",
                        PaymentMethod: paytype,
                        IsGIRO: true,
                        TotalAmt: ttlamt,
                        PaidAmt: payamt,
                        DiscAmt: discamt,
                        BalAmt: balamt,
                    },
                    success: function (response) {
                        if (response.message != null) {
                            return alert(response.message);
                        }

                        $.ajax({
                            url: '@Url.Action("GIROReceipt", "GIROs")',
                            type: "POST",
                            data: { salesId: response.SalesId },
                            success: function (res) {
                                window.close();
                                window.opener.location.href = '@Url.Action("GIROReceipt", "GIROs")' + '?salesId=' + response.SalesId;
                                var url = '@Url.Action("GIROReceipt", "Receipt")' + '?salesId=' + response.SalesId;
                                window.open(url, '_blank');
                            }
                        });
                    }
                });
            });
        });
    </script>
</head>
<body>
    <div class="payment-card">
        <div class="payment-header">
            <h2>Payment</h2><span class="invoice-id">- @Model.SalesId</span>
        </div>

        @Html.HiddenFor(m => m.CusId)

        <div class="payment-body">
            <!-- Date & Payment Method -->
            <div class="field-row">
                <label>Date</label>
                <span class="field-value">@Model.PaymentDate.ToShortDateString()</span>
            </div>
            <div class="field-row">
                <label>Payment Method</label>
                @Html.DropDownListFor(model => model.PaymentMethod,
                    new SelectList(paymentType, "TypeId", "TypeName"),
                    "----- Select -----",
                    new { @class = "form-control", style = "width:100%" })
            </div>

            <hr class="section-divider" />

            <!-- Totals -->
            <div class="total-section">
                <div class="field-row">
                    <label>Total Amount</label>
                    @Html.EditorFor(model => model.TotalAmt, new { htmlAttributes = new { @disabled = "disabled", style = "width:100%" } })
                </div>
                <div class="field-row">
                    <label>Outstanding Amount</label>
                    @Html.EditorFor(model => model.BalAmt, new { htmlAttributes = new { @disabled = "disabled", style = "width:100%" } })
                </div>
                <div class="field-row highlight-row">
                    <label>Paid Amount</label>
                    @Html.EditorFor(model => model.PaidAmt, new { htmlAttributes = new { @disabled = "disabled", style = "width:100%" } })
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.minPayAmount))
                {
                    <div class="min-pay-note">@ViewBag.minPayAmount</div>
                }
            </div>
        </div>

        <div class="payment-footer">
            <button class="btn-confirm" id="updatePayment">CONFIRM</button>
            <button class="btn-cancel" onclick="window.opener=null; window.close(); return false;">CANCEL</button>
        </div>
    </div>
</body>
